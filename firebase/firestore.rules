rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/calendarSecrets/{secretId} {
      allow get, create, update: if request.auth != null
        && request.auth.uid == userId
        && secretId == 'v1'
        && (request.method == 'get'
          || (request.resource.data.keys().hasOnly([
            'version', 'salt', 'nonce', 'ciphertext', 'mac', 'updatedAt'
          ])
          && request.resource.data.version == 1
          && request.resource.data.salt is string
          && request.resource.data.nonce is string
          && request.resource.data.ciphertext is string
          && request.resource.data.mac is string));
    }
    match /users/{userId}/backups/{backupId} {
      allow read, write: if request.auth != null
        && request.auth.uid == userId
        && backupId == 'personal-v1'
        && (request.method == 'get' || request.method == 'delete'
          || (request.resource.data.schema == 1
            && request.resource.data.keys().hasOnly(['schema', 'manualTasks', 'plans', 'uploadedAt'])
            && request.resource.data.manualTasks is list
            && request.resource.data.plans is list));
    }
  }
}
